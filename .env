# Local development settings. Comments must be on their own line, starting with #.

# Django backend
VITE_API_BASE_URL=http://localhost:8000

# true: answer API calls from src/api/demoAdapter.js instead of the backend (no server needed)
VITE_DEMO_MODE=false

# true: intercept API calls with the Mock Service Worker handlers in src/mocks/handlers.js (dev only)
VITE_USE_MSW=false
